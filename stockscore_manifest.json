    "Analyser",
    "Favoris",
    "Portefeuille",
    "Radar",
    "Guide",
    "Géopolitique",
    "Biotech Radar"
  ],
  "analysis_types": {
    "biotech": {
      "formula": "0.40×IA(/35) + 0.30×rNPV + 0.20×CatalystIntensity + 0.10×FinancialGuardrails",
      "modulation": "× RunwayFactor (0.80–1.00)",
      "ia_dims": 7,
      "ia_max": 35
    },
    "large_cap": {
      "formula": "0.60×IA(/40) + 0.40×CausalScore",
      "causal": "QualityMoat + ValuationRelative + Stability",
      "ia_dims": 8,
      "ia_max": 40
    },
    "small_cap": {
      "formula": "0.60×IA(/40) + 0.40×CausalScore",
      "causal": "SizeGrowth + Catalysts + LiquidityRisk",
      "ia_dims": 8,
      "ia_max": 40
    }
  },
  "signals": [
    "Volume Spike",
    "Insider Net Buying",
    "RSI(14)+MM50",
    "Analyst Upgrades"
  ],
  "confidence_badge": "Global Score >= 80 AND >= 2 green signals",
