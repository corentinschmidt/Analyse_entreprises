  "description": "Analyseur IA d'actions — Biotech, Large Cap, Small Cap",
  "author": "StockScore",
  "engines": {
    "ai": "Groq (LLaMA 3.3-70B)",
    "search": "Tavily",
    "news": "NewsAPI",
    "fundamentals": "Yahoo Finance",
    "clinical": "ClinicalTrials.gov",
    "fda": "FDA.gov"
